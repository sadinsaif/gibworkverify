{
  "name": "gibwork-verity",
  "version": "0.1.0",
  "description": "From bounty requirements to verifiable proof — a terminal-first developer verification tool for Gibwork bounties.",
  "type": "module",
  "bin": {
    "verity": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "gibwork",
    "bounty",
    "verification",
    "proof-of-completion",
    "evidence",
    "sha256",
    "tamper-evident",
    "solana",
    "cli",
    "terminal"
  ],
  "author": "sadinsaif",
  "license": "MIT",
  "dependencies": {
    "@gibwork/sdk": "0.2.0",
    "@solana/web3.js": "^1.98.4",
    "commander": "^14.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^4.1.11"
  }
}
