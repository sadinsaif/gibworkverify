# ---------------------------------------------------------------------------
# gibwork-verity — example environment configuration
#
# Copy to `.env` and adjust. The CLI reads these via process.env; it never
# loads a .env file implicitly and never transmits or logs secret material.
# Every value here is OPTIONAL — Verity runs zero-config for read/verify flows.
# ---------------------------------------------------------------------------

# Gibwork API environment: "production" (default) or "stage".
GIBWORK_ENV="production"

# Gibwork API timeout in milliseconds (default: 20000).
VERITY_TIMEOUT_MS="20000"

# ---------------------------------------------------------------------------
# Wallet (OPTIONAL for reads, REQUIRED for `verity submit`).
#
# The Gibwork API is wallet-authenticated even for reads. With nothing set,
# Verity auto-generates a throwaway READ-ONLY keypair under the per-user app
# directory and uses it only to sign read requests — it needs no funds.
#
# `verity submit` performs a real, paid on-chain submission (a small USDC
# participation fee). For that you MUST provide your own funded, eligible
# wallet via one of the two variables below. Verity never persists, logs, or
# transmits this key beyond the official SDK's signing.
# ---------------------------------------------------------------------------

# A base58 secret key, or a JSON array of 32/64 secret-key bytes.
# GIBWORK_PRIVATE_KEY="[1,2,3,...]"

# Path to a Solana keypair JSON file.
# GIBWORK_KEYPAIR_PATH="/path/to/keypair.json"

# ---------------------------------------------------------------------------
# Live integration test (OPTIONAL). Used only by `npm run test:live`.
# If unset, the live test discovers a real open bounty id automatically.
# ---------------------------------------------------------------------------
# GIBWORK_LIVE_TASK_ID="00000000-0000-0000-0000-000000000000"
